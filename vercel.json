{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "deploy_setup.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "feedback.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "feedback_submit.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "public/course_material.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "public/course_pdf.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "public/css/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/js/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(css|js|images|assets)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/deploy_setup\\.php$",
      "dest": "/deploy_setup.php"
    },
    {
      "src": "^/public/course_material\\.php$",
      "dest": "/public/course_material.php"
    },
    {
      "src": "^/public/course_pdf\\.php$",
      "dest": "/public/course_pdf.php"
    },
    {
      "src": "^/course_material\\.php$",
      "dest": "/public/course_material.php"
    },
    {
      "src": "^/course_pdf\\.php$",
      "dest": "/public/course_pdf.php"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.php"
    }
  ]
}

